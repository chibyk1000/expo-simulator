{
  "name": "@expo-sim/cli",
  "version": "0.1.0",
  "description": "Lightweight native desktop simulator for Expo and React Native apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chibyk1000/expo-simulator.git"
  },
  "keywords": [
    "expo",
    "react-native",
    "simulator",
    "ios",
    "android"
  ],
  "bin": {
    "expo-sim": "bin/expo-sim.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "transpile.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node ../../scripts/copy-transpile.js",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "@expo-sim/linux-x64": "0.1.0",
    "@expo-sim/linux-arm64": "0.1.0",
    "@expo-sim/darwin-x64": "0.1.0",
    "@expo-sim/darwin-arm64": "0.1.0",
    "@expo-sim/win32-x64": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0"
  }
}
